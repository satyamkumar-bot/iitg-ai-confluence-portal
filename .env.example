# ==============================================================================
# IITG AI CONFLUENCE - CENTRALIZED EVENT REGISTRATION PORTAL
# ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================

# Application Base URL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NextAuth Secret (Generate via `openssl rand -base64 32`)
NEXTAUTH_SECRET=replace-with-a-secure-random-32-byte-secret

# Microsoft Entra ID (Azure AD) OAuth Configuration
# Obtain from Azure Portal > Microsoft Entra ID > App registrations
AZURE_AD_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_AD_CLIENT_SECRET=your-entra-id-client-secret-here
# Tenant ID for IIT Guwahati (or 'common' / 'organizations' if multi-tenant)
AZURE_AD_TENANT_ID=00000000-0000-0000-0000-000000000000

# Server-Controlled Administrator Email Allowlist (comma separated)
# Users with these verified emails will automatically be assigned the 'ORGANIZER' role upon login
ORGANIZER_ADMIN_EMAILS=confluence.admin@iitg.ac.in,faculty.mfsdsai@iitg.ac.in,chair.aiconfluence@iitg.ac.in

# Developer Mock Authentication (Set to 'true' only in local development when live Entra ID credentials are unavailable)
# When 'true', a prominent banner is shown and a toggle allows switching between Student and Organizer roles for local testing.
ENABLE_DEV_AUTH_MOCK=true

# Database Configuration (Supabase PostgreSQL)
# Obtain from Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here
# Optional Direct Database URL for Prisma/Drizzle/pg migrations
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Microsoft Forms / Power Automate Webhook Integration Secret
# Used to authenticate incoming HTTP requests from Power Automate to /api/integrations/microsoft-forms/responses
# Must match the 'x-api-key' header configured in the Power Automate HTTP action
POWER_AUTOMATE_INTEGRATION_KEY=iitg_msforms_webhook_secret_key_change_in_prod

# Optional Email / Notification Service
EMAIL_SERVER_HOST=smtp.office365.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=aiconfluence@iitg.ac.in
EMAIL_SERVER_PASSWORD=your-email-password-or-app-secret
EMAIL_FROM="IITG AI Confluence" <aiconfluence@iitg.ac.in>
